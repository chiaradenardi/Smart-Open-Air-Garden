    {
        "id": "913ea94b7f3f4398",
        "type": "function",
        "z": "735c512bb2eabce7",
        "name": "function 2",
        "func": "var datiStoriciFinti = [\n    {\"time\": \"2026-03-13T19:00:00Z\", \"value\": 35.0},\n    {\"time\": \"2026-03-13T19:15:00Z\", \"value\": 38.5},\n    {\"time\": \"2026-03-13T19:30:00Z\", \"value\": 42.0},\n    {\"time\": \"2026-03-13T19:50:00Z\", \"value\": 45.2}\n];\n\nvar messaggi = [];\nfor (var i = 0; i < datiStoriciFinti.length; i++) {\n    messaggi.push({\n        payload: datiStoriciFinti[i].value,         \n        topic: \"soil_moisture\",          \n        timestamp: new Date(datiStoriciFinti[i].time).getTime() \n    });\n}\nreturn [messaggi];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 280,
        "wires": [
