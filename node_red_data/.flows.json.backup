    {
        "id": "3908f7dfebde91dc",
        "type": "function",
        "z": "735c512bb2eabce7",
        "name": "function 1",
        "func": "// Il payload in arrivo è la lista (array) di sensori SenML\nvar sensori = msg.payload;\n\n// Prepariamo due messaggi vuoti\nvar msgUmidita = null;\nvar msgTemperatura = null;\n\n// Controlliamo che i dati siano effettivamente una lista\nif (Array.isArray(sensori)) {\n    // Passiamo in rassegna ogni elemento della lista\n    for (var i = 0; i < sensori.length; i++) {\n        var dato = sensori[i];\n\n        // Se l'elemento (n) si chiama umidità del suolo...\n        if (dato.n === \"soil_moisture\") {\n            // ...estraiamo il valore (v) e prepariamo il messaggio\n            msgUmidita = { payload: dato.v };\n        }\n        // Se invece si chiama temperatura...\n        else if (dato.n === \"temperature\") {\n            // ...estraiamo il suo valore\n            msgTemperatura = { payload: dato.v };\n        }\n    }\n}\n\n// Restituiamo i due messaggi separati. \n// Il primo andrà all'uscita 1 (in alto), il secondo all'uscita 2 (in basso).\nreturn [msgUmidita, msgTemperatura];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 140,
        "wires": [
            [
                "b136585b2891a82b",
                "0c645f0db8147e69"
            ],
            [
                "47aaad8b5b3807d3"
            ]
        ]
    },
