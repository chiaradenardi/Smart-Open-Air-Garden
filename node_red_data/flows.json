    {
        "id": "f766a2d8a915a8c4",
        "type": "function",
        "z": "e416cf0bed26c885",
        "name": "🎯 Extract Statistics",
        "func": "if (msg.payload && msg.payload.statistics) {\n    var stats = msg.payload.statistics;\n    msg.payload = {\n        liters_saved: stats.liters_saved,\n        savings_percentage: stats.savings_percentage,\n        pump_activations: stats.pump_activations_smart,\n        liters_smart: stats.liters_used_smart,\n        liters_fixed: stats.liters_fixed_timer,\n        minutes_smart: stats.minutes_used_smart,\n        minutes_fixed: stats.minutes_fixed_timer,\n        euros_saved: stats.euros_saved,\n        cost_per_liter: stats.cost_per_liter,\n        timestamp: new Date().toLocaleString('it-IT')\n    };\n}\nreturn msg;",
