    {
        "id": "3a5627528a9605b3",
        "type": "function",
        "z": "e416cf0bed26c885",
        "name": "🔄 Split Sensors",
        "func": "// Gestisce ENTRAMBI i formati: SenML e flat JSON\nvar sensori = msg.payload;\nvar msgUmidita = null;\nvar msgTemperatura = null;\nvar msgPompa = null;\n\n// Se è un array SenML\nif (Array.isArray(sensori)) {\n    for (var i = 0; i < sensori.length; i++) {        \n        var dato = sensori[i];\n        \n        if (dato.n === \"soil_moisture\") {\n            msgUmidita = { payload: parseFloat(dato.v) || 0, topic: \"soil_moisture\" };\n        }\n        else if (dato.n === \"temperature\") {\n            msgTemperatura = { payload: parseFloat(dato.v) || 0, topic: \"temperature\" };\n        }\n        else if (dato.n === \"pump_status\") {\n            msgPompa = { payload: parseFloat(dato.v) || 0, topic: \"pump_status\" };\n        }\n    }\n}\n// Se è un oggetto flat (come quello di device_connector)\nelse if (typeof sensori === 'object') {\n    msgTemperatura = { payload: parseFloat(sensori.temperature) || 0, topic: \"temperature\" };\n    msgUmidita = { payload: parseFloat(sensori.soil_moisture) || 0, topic: \"soil_moisture\" };\n    if (sensori.pump_status) {\n        msgPompa = { payload: parseFloat(sensori.pump_status) || 0, topic: \"pump_status\" };\n    }\n}\n\nreturn [msgUmidita, msgTemperatura, msgPompa];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1580,
        "y": 620,
        "wires": [
            [
                "ddbb23f24a5436c6",
                "16e293333cd5dfb8",
                "dddb210baaaacbeb"
            ],
            [
                "02ed0ecf9813ccea"
            ],
            [
                "d021e0aa87dacd3d"
            ]
        ]
    },
