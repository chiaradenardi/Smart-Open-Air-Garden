    {
        "id": "91e1b64167961ae6",
        "type": "function",
        "z": "e416cf0bed26c885",
        "name": "🔄 Split Sensors",
        "func": "var sensori = msg.payload;\nvar msgUmidita = null;\nvar msgTemperatura = null;\nvar msgPompa = null;\n\n// Extract device_id from topic (e.g., garden/RPi_001/telemetry -> RPi_001)\nvar topic_parts = msg.topic.split('/');\nvar device_id = topic_parts[1] || 'unknown';\n\nif (Array.isArray(sensori)) {\n    for (var i = 0; i < sensori.length; i++) {\n        var dato = sensori[i];\n        if (dato.n === 'soil_moisture') { msgUmidita = { payload: parseFloat(dato.v) || 0, topic: device_id, device_id: device_id, sensor: 'soil_moisture' }; }\n        else if (dato.n === 'temperature') { msgTemperatura = { payload: parseFloat(dato.v) || 0, topic: device_id, device_id: device_id, sensor: 'temperature' }; }\n        else if (dato.n === 'pump_status') { msgPompa = { payload: parseFloat(dato.v) || 0, topic: device_id, device_id: device_id, sensor: 'pump_status' }; }\n    }\n} else if (sensori && typeof sensori === 'object') {\n    msgUmidita = { payload: parseFloat(sensori.soil_moisture) || 0, topic: device_id, device_id: device_id, sensor: 'soil_moisture' };\n    msgTemperatura = { payload: parseFloat(sensori.temperature) || 0, topic: device_id, device_id: device_id, sensor: 'temperature' };\n    msgPompa = { payload: parseFloat(sensori.pump_status) || 0, topic: device_id, device_id: device_id, sensor: 'pump_status' };\n}\n\nreturn [msgUmidita, msgTemperatura, msgPompa];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1700,
        "y": 1440,
        "wires": [
