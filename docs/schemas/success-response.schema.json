{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standardized Success Response",
  "description": "Consistent success response format used across all REST API services",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success"],
      "description": "Status indicator (always 'success' for successful responses)"
    },
    "data": {
      "description": "Response payload (can be any valid JSON structure)",
      "oneOf": [
        { "type": "object" },
        { "type": "array" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "message": {
      "type": "string",
      "description": "Optional human-readable success message"
    }
  },
  "required": ["status", "data"],
  "additionalProperties": false,
  "examples": [
    {
      "status": "success",
      "data": {
        "result": "Water price successfully updated",
        "newPrice": 1.5
      }
    },
    {
      "status": "success",
      "data": [
        {
          "slotID": "slot_1",
          "plantID": "tomato",
          "deviceID": "RPi_001"
        }
      ],
      "message": "Retrieved 1 garden slot"
    }
  ]
}
