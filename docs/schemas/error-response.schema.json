{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standardized Error Response",
  "description": "Consistent error response format used across all REST API services",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["error"],
      "description": "Status indicator (always 'error' for error responses)"
    },
    "code": {
      "type": "string",
      "description": "Error code identifier (e.g., 'VALIDATION_ERROR', 'NOT_FOUND', 'CONFLICT', 'SERVER_ERROR')"
    },
    "message": {
      "type": "string",
      "description": "Human-readable error message"
    },
    "details": {
      "type": "object",
      "description": "Additional error context and details",
      "additionalProperties": true
    }
  },
  "required": ["status", "code", "message"],
  "additionalProperties": false,
  "example": {
    "status": "error",
    "code": "VALIDATION_ERROR",
    "message": "Missing required field",
    "details": {
      "field": "NewWaterPricePerM3",
      "reason": "Field is required in request body"
    }
  }
}
