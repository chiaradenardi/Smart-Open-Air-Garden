{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SenML Telemetry Message",
  "description": "Sensor Markup Language format for IoT sensor telemetry data (RFC 8428)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "bn": {
        "type": "string",
        "description": "Base name of the device (e.g., 'RPi_001/')"
      },
      "n": {
        "type": "string",
        "description": "Measurement name (e.g., 'temperature', 'soil_moisture', 'air_humidity')",
        "enum": [
          "temperature",
          "air_humidity",
          "soil_moisture",
          "pump_status"
        ]
      },
      "v": {
        "oneOf": [
          { "type": "number" },
          { "type": "integer" },
          { "type": "boolean" },
          { "type": "string" }
        ],
        "description": "Measurement value"
      },
      "u": {
        "type": "string",
        "description": "Unit of measurement (e.g., 'Cel' for Celsius, '%RH' for relative humidity, '%' for percentage)"
      },
      "t": {
        "type": "integer",
        "description": "Timestamp in Unix time (seconds since epoch)"
      }
    },
    "required": ["n", "v", "t"],
    "additionalProperties": false
  },
  "minItems": 1,
  "example": [
    {
      "bn": "RPi_001/",
      "n": "temperature",
      "v": 20.5,
      "u": "Cel",
      "t": 1234567890
    },
    {
      "n": "air_humidity",
      "v": 45.0,
      "u": "%RH",
      "t": 1234567890
    },
    {
      "n": "soil_moisture",
      "v": 65.2,
      "u": "%",
      "t": 1234567890
    }
  ]
}
