{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MQTT Broker Configuration",
  "description": "MQTT broker connection configuration returned by service catalog",
  "type": "object",
  "properties": {
    "broker_name": {
      "type": "string",
      "description": "Broker hostname or IP address"
    },
    "broker_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Broker port number (default: 1883 for MQTT)"
    }
  },
  "required": ["broker_name", "broker_port"],
  "additionalProperties": false,
  "example": {
    "broker_name": "message-broker",
    "broker_port": 1883
  }
}
