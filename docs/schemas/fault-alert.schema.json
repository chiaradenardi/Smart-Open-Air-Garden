{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fault Detection Alert",
  "description": "Alert message published when pump failure or leak is detected",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "description": "Device ID where fault was detected (e.g., 'RPi_001')"
    },
    "error": {
      "type": "string",
      "enum": ["PUMP_FAILURE_OR_LEAK"],
      "description": "Type of error detected"
    },
    "val_now": {
      "type": "number",
      "description": "Current soil moisture value (%)"
    },
    "val_init": {
      "type": "number",
      "description": "Initial soil moisture value when pump started (%)"
    },
    "time_iso": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp in ISO 8601 format when alert was generated"
    }
  },
  "required": ["target", "error", "val_now", "val_init", "time_iso"],
  "additionalProperties": false,
  "example": {
    "target": "RPi_001",
    "error": "PUMP_FAILURE_OR_LEAK",
    "val_now": 65.2,
    "val_init": 60.0,
    "time_iso": "2024-05-18T12:42:12.221000+00:00"
  }
}
